<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page de Paiement</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/CSS/paiement.css">
</head>

<body>
  <%- include ("../partials/header.ejs") %>

    <div class="row">
      <!-- Conteneur des réservations -->
      <div class="col-50">
        <div class="containerListe">
          <h3>Mon Panier</h3>
          <p>Voici vos réservations :</p>
          <div class="user-reservations">
            <% if (reservations.length> 0) { %>
              <ul>
                <% reservations.forEach(function(reservation) { %>
                  <li>
                    <strong>
                      <%= reservation.categorie_sport %>
                    </strong> -
                    <span class="price">
                      <%= reservation.prix %> €
                    </span>
                    <br>
                    <span><strong>Date :</strong>
                      <%= new Date(reservation.date_time).toLocaleDateString("fr-FR") %>
                    </span>
                    <br>
                    <span><strong>Heure :</strong>
                      <%= new Date(reservation.date_time).toLocaleTimeString("fr-FR", { hour: "2-digit" ,
                        minute: "2-digit" }) %>
                        <span>À
                          <%= new Date(reservation.date_time_fin).toLocaleTimeString("fr-FR", { hour: "2-digit" ,
                            minute: "2-digit" }) %>
                        </span>
                    </span>


                  </li>
                  <% }); %>
              </ul>
              <% } else { %>
                <p>Aucune réservation trouvée.</p>
                <% } %>
          </div>
          <br>
          <button class="btn-checkout" onclick="window.location.href='/checkout'">Proceed to Checkout</button>
        </div>
      </div>


</body>

</html>