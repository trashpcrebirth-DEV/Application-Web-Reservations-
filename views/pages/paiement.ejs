<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page de Paiement</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/CSS/paiement.css">
</head>

<body>
  <%- include ("../partials/header.ejs") %>

    <div class="row">
      <!-- Conteneur des réservations -->
      <div class="col-50">
        <div class="containerListe">
          <h3>Mon Panier</h3>
          <p>Voici vos réservations :</p>
          <div class="user-reservations">
            <% if (reservations.length> 0) { %>
              <ul>
                <% reservations.forEach(function(reservation) { %>
                  <li>
                    <strong>
                      <%= reservation.categorie_sport %> (<%= reservation.nombreJoueur %>x)
                    </strong> -
                    <span class="price">
                      <%= reservation.prix %> $
                    </span>
                    <br>
                    <span><strong>Date :</strong>
                      <%= new Date(reservation.date_time).toLocaleDateString("fr-FR") %>
                    </span>
                    <br>
                    <span><strong>Heure :</strong>
                      <%= new Date(reservation.date_time).toLocaleTimeString("fr-FR", { hour: "2-digit" ,
                        minute: "2-digit" }) %>
                        <span>À
                          <%= new Date(reservation.date_time_fin).toLocaleTimeString("fr-FR", { hour: "2-digit" ,
                            minute: "2-digit" }) %>
                        </span>
                    </span>
                    <button class="remove-btn" onclick="removeReservation(<%= reservation.id_reservation %>)">x</button>


                  </li>
                  <% }); %>
              </ul>
              <% } else { %>
                <p>Aucune réservation trouvée.</p>
                <% } %>
          </div>
          <br>
          <button class="btn-checkout" onclick="window.location.href='/checkout'" <%= reservations.length === 0 ? 'disabled' : '' %>> Proceed to Checkout </button>   
               </div>
      </div>


</body>

<script>
  function removeReservation(reservationId) {
      fetch(`/api/items/${reservationId}`, {
          method: 'DELETE',
          headers: {
              'Content-Type': 'application/json'
          }
      })
      .then(response => response.json())
      .then(data => {
          if (data.success) {
              // Rafraîchir la page pour mettre à jour la liste des réservations
              location.reload();
          } else {
              alert(data.message);
          }
      })
      .catch(err => {
          console.error("Erreur lors de la suppression :", err);
          alert("Erreur lors de la suppression de la réservation.");
      });
  }
</script>
</html>