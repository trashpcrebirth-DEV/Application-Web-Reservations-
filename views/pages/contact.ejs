<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact - Réservation de Terrains Sportifs</title>
    <link rel="stylesheet" href="../CSS/contact.css">
    <link rel="icon" type="image/png" href="/images/favicon.png">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@5.15.4/css/fontawesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600&display=swap" rel="stylesheet">
</head>

<body class="banniere">
    <%- include ("../partials/header.ejs") %>

    <div class="conteneur-principal">
        <h1 class="titre-page">Nous contacter</h1>
        
        <div class="grille-formulaires">
            <div class="carte-formulaire">
                <div class="entete-carte">
                    <span class="icone-carte"><i class="fas fa-star"></i></span>
                    <h2 class="titre-section">Partagez votre expérience avec un avis</h2>
                </div>
                
                <form action="/ajouter-avis" method="POST" class="formulaire">
                    <div class="groupe-champ">
                        <label for="nom"><i class="fas fa-user"></i> Votre nom</label>
                        <input type="text" id="nom" name="nom" placeholder="Entrez votre nom" required>
                    </div>
                    
                    <div class="groupe-champ">
                        <label for="email"><i class="fas fa-envelope"></i> Votre email</label>
                        <input type="email" id="email" name="email" placeholder="Entrez votre email" required>
                    </div>
                    
                    <div class="groupe-champ">
                        <label for="note"><i class="fas fa-star"></i> Votre note</label>
                        <div class="selecteur-note">
                            <input type="radio" id="note5" name="note" value="5">
                            <label for="note5" class="label-note">★</label>
                            
                            <input type="radio" id="note4" name="note" value="4">
                            <label for="note4" class="label-note">★</label>
                            
                            <input type="radio" id="note3" name="note" value="3">
                            <label for="note3" class="label-note">★</label>
                            
                            <input type="radio" id="note2" name="note" value="2">
                            <label for="note2" class="label-note">★</label>
                            
                            <input type="radio" id="note1" name="note" value="1">
                            <label for="note1" class="label-note">★</label>
                        </div>
                    </div>
                    
                    <div class="groupe-champ">
                        <label for="commentaire"><i class="fas fa-comment"></i> Votre avis</label>
                        <textarea id="commentaire" name="commentaire" rows="4" placeholder="Partagez votre expérience avec nous" required></textarea>
                    </div>
                    
                    <div class="groupe-bouton">
                        <button type="submit" class="bouton-envoi">
                            <i class="fas fa-paper-plane"></i>
                             Envoyer votre avis
                        </button>
                    </div>

                    <div>
                        <li class="contact-gif"></li>
                    </div>
                </form>
            </div>
            
            <div class="carte-formulaire">
                <div class="entete-carte">
                    <span class="icone-carte"><i class="fas fa-calendar-alt"></i></span>
                    <h2 class="titre-section">Organisez votre événement</h2>
                </div>
                
                <form action="/ajouter-evenement" method="POST" class="formulaire"  enctype="multipart/form-data">
                    <div class="groupe-champ">
                        <label for="nom-organisateur"><i class="fas fa-user"></i> Nom de l'organisateur</label>
                        <input type="text" id="nom-organisateur" name="nom-organisateur" placeholder="Entrez votre nom" required>
                    </div>
                    
                    <div class="groupe-champ moitie">
                        <label for="email-organisateur"><i class="fas fa-envelope"></i> Email</label>
                        <input type="email" id="email-organisateur" name="email-organisateur" placeholder="Entrez votre email" required>
                    </div>
                    
                    <div class="groupe-champ moitie">
                        <label for="telephone"><i class="fas fa-phone"></i> Téléphone</label>
                        <input type="text" id="telephone" name="telephone" placeholder="Votre numéro" required>
                    </div>
                    
                    <div class="groupe-champ">
                        <label for="nom"><i class="fa-solid fa-clipboard"></i> Entrez le nom de l'évenement</label>
                        <input type="text" id="nom" name="nom" placeholder="Entrez le nom de l'évenement" required>
                    </div>

                    <div class="groupe-champ">
                        <label for="image_url "><i class="fas fa-image"></i> Ajouter une image de l'événement</label>
                        <input type="file" id="image_url " name="image_url" accept="image/*">
                    </div>
                    
                    <div class="groupe-champ moitie">
                        <label for="lieu"><i class="fas fa-futbol"></i> Lieu</label>
                        <select id="lieu" name="lieu" required>
                            <option value="" disabled selected>Sélectionnez un lieu</option>
                            <option value="Basketball">Terrain Basketball</option>
                            <option value="foot">Terrain Football/Soccer</option>
                            <option value="gymnase">Gymnase Handball</option>
                            <option value="cricket">Terrain Cricket</option>
                            <option value="piscine">Pisicine SportZone</option>
                            <option value="piscine-loisir">Pisicine Loisir</option>
                            <option value="muscu">Salle de musculation</option>
                            <option value="studio">Studio collectif</option>
                            <option value="tennis">Cours de Tennis</option>
                            <option value="tennis">Gymnase Badminton</option>
                            <option value="squash">Gymnase Squash</option>
                            <option value="escalade">Emplacement d'escalade</option>
                            <option value="piste">Piste athlétique</option>
                            <option value="dojo">Dojo</option>
                            <option value="parc">Le Parc</option>
                            <option value="golf">Parc pour Golf</option>
                        </select>
                    </div>

                    <div class="groupe-champ moitie">
                        <label for="type"><i class="fa-solid fa-filter"></i> Type d'évenement</label>
                        <select id="type" name="type" required>
                            <option value="" disabled selected>Sélectionnez un type</option>
                            <option value="Individuel">Individuel</option>
                            <option value="Equipe">En équipe</option>
                        </select>
                    </div>

                    <div class="groupe-champ moitie">
                        <label for="date_evenement"><i class="fas fa-calendar-day"></i> Date souhaitée</label>
                        <input type="date" id="date_evenement" name="date_evenement" required>
                    </div>
                    
                    <div class="groupe-champ moitie">
                        <label for="participants"><i class="fas fa-users"></i> Participants</label>
                        <input type="number" id="participants" name="participants" min="1" placeholder="Nombre" required>
                    </div>
                    
                    <div class="groupe-champ">
                        <label for="description"><i class="fas fa-info-circle"></i> Détails de l'événement</label>
                        <textarea id="description" name="description" rows="4" placeholder="Décrivez votre événement" required></textarea>
                    </div>
                    
                    <div class="groupe-bouton">
                        <button type="submit" class="bouton-envoi">
                            <i class="fas fa-paper-plane"></i>
                             Demander un devis
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <%- include ("../partials/footer.ejs") %>

    <script>
        // vérifie si le paramètre 'alert' est dans l'URL
        const urlParams = new URLSearchParams(window.location.search);
        const alertMessageAvis = urlParams.get('alertAvis');
        const alertMessageEvenement = urlParams.get('alertEvenement');

    
        if (alertMessageAvis === 'success') {
            alert('Votre avis a été transféré avec succès!');
        }

        if(alertMessageEvenement === 'success') {
            alert("Votre demande d'evenement a été envoyée avec succès!");
        }
    </script>
