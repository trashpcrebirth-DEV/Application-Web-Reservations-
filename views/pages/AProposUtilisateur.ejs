<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nos utilisateurs</title>
    <link rel="stylesheet" href="/CSS/AproposUtilisateur.css">

</head>
<body>
    <%- include ("../partials/header.ejs") %>
    <!--BODY-->
    <section class="affichage-titre">
        <div>
            <h1>Avis de nos utilisateurs</h1>
            <p>Découvrez ce que nos clients disent de leur expérience avec SportZone</p>
        </div>
    </section>

    <section class="avis">
        <div class="conteneur">
            <div class="avis-grid">
                <% avis.forEach(function(avi) { %>
                    <div class="card-avis">
                        <div>
                            <div class="utilisateur-info">
                                <img src="<%= avi.photoProfile %>" alt="<%= avi.nom %>" class="photo-profile">
                                <div class="utilisateur-details">
                                    <h3 class="utilisateur-nom"><%= avi.nom %></h3>
                                    <p class="date"><%= avi.date %></p>
                                </div>
                            </div>
                            <div class="note">
                                <% for(let i = 0; i < avi.note; i++) { %>
                                    <span class="star">&#9733;</span> <!--https://www.alt-codes.net/star_alt_code.php-->
                                <% } %>
                            </div>
                        </div>
                        <p class="commentaire"><%= avi.commentaire %></p>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>
    <!--FIN DU BODY-->
    <%- include ("../partials/footer.ejs") %>
</body>
</html>