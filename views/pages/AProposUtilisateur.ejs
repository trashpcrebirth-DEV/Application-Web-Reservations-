<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nos utilisateurs</title>
    <link rel="stylesheet" href="/CSS/AproposUtilisateur.css">
</head>
<body>
    <%- include ("../partials/header.ejs") %>
    <!--BODY-->
    <section class="banniere">
        <div class="conteneur">
            <h2>Avis de nos utilisateurs</h1>
            <p>Découvrez ce que nos clients disent de leur expérience avec SportZone</p>
        </div>
    </section>

    <section class="avis">
        <button class="navigation-button arriere">&lt;</button>
        <div class="conteneur">
            <div class="navigation-container">
                <div class="avis-navigation">
                    <% avis.forEach(function(avi) { %>
                        <div class="card-avis">
                            <div>
                                <div class="utilisateur-info">
                                    <img src="<%= avi.image %>" alt="<%= avi.nom %>" class="photo-profile">
                                    <div class="utilisateur-details">
                                        <h3 class="utilisateur-nom"><%= avi.nom %></h3>
                                        <p class="date">Date de l'avis: <%= new Date(avi.date).toLocaleDateString() %></p> <!-- https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Date/toLocaleDateString -->
                                    </div>
                                </div>
                                <div class="note">
                                    <% for(let i = 0; i < avi.note; i++) { %>
                                        <span class="star">&#9733;</span> <!--https://www.alt-codes.net/star_alt_code.php-->
                                    <% } %>
                                </div>
                            </div>
                            <p class="commentaire"><%= avi.commentaire %></p>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>
        <button class="navigation-button avancer">&gt;</button>
    </section>

    <section class="contacter-section">
        <div class="conteneur">
            <h3>Vous avez déjà essayé Sportzone?</h3>
            <p>Laissez un avis pour nois faire découvrir votre expérience chez SportZone.</p>
            <div class="boutons">
                <a href="/contact" class="bouton-contacter"><i class="fa-solid fa-calendar"></i> Laissez un avis!</a> 
            </div>
        </div>
    </section>
    <!--FIN DU BODY-->
    <%- include ("../partials/footer.ejs") %>
    <script src="/Javascript/AproposUtilisateur.js"></script>
    <script>
        window.__ow = window.__ow || {};
