<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nos utilisateurs</title>
    <link rel="stylesheet" href="/CSS/AproposUtilisateur.css">

</head>
<body>
    <%- include ("../partials/header.ejs") %>
    <!--BODY-->
    <main>
        <section class="aPropos-section">
          <h1>À propos de nous</h1>
          <p>
            Bienvenue sur notre site ! Nous sommes engagés à offrir le meilleur service à nos utilisateurs, et nous aimons entendre leurs retours. Découvrez ce que disent nos utilisateurs à propos de leur expérience avec nous.
          </p>
        </section>
    
        <section class="avis-section">
          <h2>Ce que nos utilisateurs disent</h2>
          <div class="avis">
            <% reviews.forEach((review) => { %>
              <div class="card-avis">
                <h3><%= review.userName %></h3>
                <p>"<%= review.comment %>"</p>
                <p class="note">Note : <%= review.rating %>/5</p>
              </div>
            <% }) %>
          </div>
        </section>
      </main>
    <!--FIN DU BODY-->
    <%- include ("../partials/footer.ejs") %>
</body>
</html>