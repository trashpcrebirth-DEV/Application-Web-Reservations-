<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page de Succès</title>
  <link rel="icon" type="image/png" href="/images/favicon.png">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/CSS/confirmation.css">
  <style>

  </style>
</head>

<body>
  <div class="loading-container">
    <div class="loading-dots">
      <span>.</span>
      <span>.</span>
      <span>.</span>
    </div>
    <div class="animation-container">
      <div class="card"></div>
      <div class="machine">
        <div class="green-dot" style="display: none;"></div>
      </div>
    </div>
  </div>



  <div class="success-container" style="display: none;">
    <i class="fa fa-check-circle"></i>
    <h1>Succès</h1>
    <h2>Votre réservation a été confirmée avec succès !</h2>
    <a href="/" class="btn">Retour à l'accueil</a>
    <a class="btn" href="/facture">Télécharger facture</a>
  </div>

  <script>
    setTimeout(() => {
      const greenDot = document.querySelector('.machine .green-dot');
      if (greenDot) {
        greenDot.style.display = 'block';
      }
    }, 4000);

    setTimeout(() => {
      const loadingContainer = document.querySelector('.loading-container');
      const successContainer = document.querySelector('.success-container');

      if (loadingContainer) {
        loadingContainer.classList.add('fade-out');
      }

      setTimeout(() => {
        if (loadingContainer) {
          loadingContainer.style.display = 'none';
        }
        if (successContainer) {
          successContainer.style.display = 'block';
          successContainer.classList.add('fade-in', 'show');


          startFireworks();
        }
      }, 500);
    }, 4500);


  </script>


</body>

</html>