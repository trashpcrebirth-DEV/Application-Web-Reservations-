<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page de Succès</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/CSS/confirmation.css">
  <style>
  
  </style>
</head>

<body>
    <div class="success-container">
      <i class="fa fa-check-circle"></i>
      <h1>Succès</h1>
      <h2>Votre réservation a été confirmée avec succès !</h2>
      <p class="redirect-info">Vous allez être redirigé vers la page d'accueil sous peu.</p>
      <a href="/" class="btn-redirect">Retour à l'accueil</a>
    </div>
  
    <script>
      // Redirection automatique après 10 secondes
      setTimeout(function() {
        window.location.href = '/';
      }, 10000);
    </script>
  </body>

</html>
