          <div class="day-header">Lun</div>
          <div class="day-header">Mar</div>
          <div class="day-header">Mer</div>
          <div class="day-header">Jeu</div>
          <div class="day-header">Ven</div>
          <div class="day-header">Sam</div>
        </div>
        <div id="daysGrid" class="calendrier-grid"></div>
      </div>
    </div>
    
    <div id="listeReservations" class="liste-reservations">
      <h2>Réservations</h2>
      <p id="dateSelectionnee" class="date-selectionnee">Sélectionnez une date</p>
      <div id="reservationList">
        <p class="aucune-reservation">Aucune réservation sélectionnée</p>
