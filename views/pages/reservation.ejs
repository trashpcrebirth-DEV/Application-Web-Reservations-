<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Réservation</title>
  <link rel="stylesheet" href="/CSS/Reservation.css">
</head>
<body class="banner">
  <%- include ("../partials/header.ejs") %>
  <div class="bar">
    <label>Catégorie:</label>
    <select id="sportFilter">
      <option value="">Tous les sports</option> 
      <option value="Athlétisme">Athlétisme</option>
      <option value="Arts Martiaux">Arts Martiaux</option>
      <option value="Basketball">Basketball</option>
      <option value="Badminton">Badminton</option>
      <option value="Cricket">Cricket</option>
      <option value="Cours Collectifs">Cours Collectifs</option>
      <option value="Escalade">Escalade</option>
      <option value="Golf">Golf</option>
      <option value="Handball">Handball</option>
      <option value="Hockey">Hockey</option>
      <option value="Natation">Natation</option>
      <option value="Musculation">Musculation</option>
      <option value="Tennis">Tennis</option>
      <option value="Volleyball">Volleyball</option>
      <option value="Soccer">Soccer</option>
      <option value="Squash">Squash</option>
      <option value="Skating">Skating</option>
    </select>
    <label>Installation</label>
    <select id="installationFilter">
      <option value="">Toutes les installations</option>
      <option value="Arena de Hockey">Arena de Hockey</option>
      <option value="Bassin Olympique">Bassin Olympique</option>
      <option value="Bassin d'apprentissage">Bassin d'apprentissage</option>
      <option value="Pisicine de Loisir">Pisicine de Loisir</option>
      <option value="Terrain de Badminton Double">Terrain de Badminton Double</option>
      <option value="Terrain de Badminton Single">Terrain de Badminton Single</option>
      <option value="Terrain de Basketball A - Intérieur">Terrain de Basketball A - Intérieur</option>
      <option value="Terrain de Basketball B - Extérieur">Terrain de Basketball B - Extérieur</option>
      <option value="Terrain de Basketball C - Extérieur">Terrain de Basketball C - Extérieur</option>
      <option value="TTerrain de Cricket">Terrain de Cricket</option>
      <option value="Terrain de Handball A">Terrain de Handball A</option>
      <option value="Terrain de Handball B">Terrain de Handball B</option>
      <option value="Terrain de Handball C">Terrain de Handball C</option>
      <option value="Terrain de Tennis Double">Terrain de Tennis Double</option>
      <option value="Terrain de Tennis Single">Terrain de Tennis Single</option>
      <option value="Terrain de Soccer A">Terrain de Soccer A</option>
      <option value="Terrain de Soccer B">Terrain de Soccer B</option>
      <option value="Terrain de Soccer C">Terrain de Soccer C</option>
      <option value="Terrain de Squash Double">Terrain de Squash Double</option>
      <option value="Terrain de Squash Single">Terrain de Squash Single</option>
      <option value="Terrain de Volleyball A">Terrain de Volleyball A</option>
      <option value="Terrain de Volleyball B">Terrain de Volleyball B</option>
      <option value="Terrain de Volleyball C">Terrain de Volleyball C</option>
      <option value="Salle de Musculation 1">Salle de Musculation 1</option>
      <option value="Salle de Musculation 2">Salle de Musculation 2</option>
      <option value="Studio 1">Studio 1</option>
      <option value="Studio 2">Studio 2</option>
      <option value="Studio 3">Studio 3</option>
    </select>

  </div>

  <div class="container">
    <div class="calendrier-container">
      <h1>Calendrier</h1>
      <div class="calendrier">
        <div class="calendrier-header">
          <button class="avant" id="prevMonth">&lt;</button>
          <span class="month-year" id="monthYear">Janvier 2025</span>
          <button class="apres" id="nextMonth">&gt;</button>
        </div>
        <div class="calendrier-grid">
          <div class="day-header">Dim</div>
          <div class="day-header">Lun</div>
          <div class="day-header">Mar</div>
          <div class="day-header">Mer</div>
          <div class="day-header">Jeu</div>
          <div class="day-header">Ven</div>
          <div class="day-header">Sam</div>
        </div>
        <div id="daysGrid" class="calendrier-grid"></div>
      </div>
    </div>
    
    <div id="listeReservations" class="liste-reservations">
      <h2>Réservations</h2>
      <p id="dateSelectionnee" class="date-selectionnee">Sélectionnez une date</p>
      <div id="reservationList">
        <p class="aucune-reservation">Aucune réservation sélectionnée</p>
      </div>
    </div>
  </div>

  <script src="/Javascript/calendrier.js"></script>
  <%- include ("../partials/footer.ejs") %>
</body>
</html>

