  <!-- Particles Animation Script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const particlesContainer = document.getElementById('particles');
      
      function createParticle() {
        const particle = document.createElement('div');
        particle.classList.add('particle');
        
        // Position aléatoire
        const posX = Math.random() * window.innerWidth;
        const posY = Math.random() * window.innerHeight;
        
        // Taille aléatoire
        const size = Math.random() * 5 + 2;
        
        // Vitesse aléatoire
        const speedX = (Math.random() - 0.5) * 2;
        const speedY = (Math.random() - 0.5) * 2;
        
        // Appliquer les styles
        particle.style.width = `${size}px`;
        particle.style.height = `${size}px`;
        particle.style.left = `${posX}px`;
        particle.style.top = `${posY}px`;
        particle.style.opacity = Math.random() * 0.5 + 0.2;
        
        particlesContainer.appendChild(particle);
        
        // Animation
        let x = posX;
        let y = posY;
        
        function animate() {
          x += speedX;
          y += speedY;
          
          // Rebondir sur les bords
          if (x < 0 || x > window.innerWidth) {
            x = Math.max(0, Math.min(x, window.innerWidth));
          }
          if (y < 0 || y > window.innerHeight) {
            y = Math.max(0, Math.min(y, window.innerHeight));
          }
          
          particle.style.left = `${x}px`;
          particle.style.top = `${y}px`;
          
          // Continuer l'animation ou supprimer la particule
          if (Math.random() < 0.002 || x < 0 || x > window.innerWidth || y < 0 || y > window.innerHeight) {
            particle.remove();
          } else {
            requestAnimationFrame(animate);
          }
        }
        
        requestAnimationFrame(animate);
      }
      
      // Créer des particules initiales
      for (let i = 0; i < 50; i++) {
        createParticle();
      }
      
      // Créer de nouvelles particules périodiquement
      setInterval(() => {
        if (particlesContainer.children.length < 100) {
          createParticle();
        }
      }, 300);
    });
  </script>
  
