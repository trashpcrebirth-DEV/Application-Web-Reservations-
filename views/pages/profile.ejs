<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <link rel="stylesheet" href="../CSS/profile.css">
</head>

<body style="background-color:rgb(22, 23, 21);">
    <%- include ("../partials/header.ejs") %>
        <div class="forme">
            <div class="profile-container">
                <div class="profile-cercle">
                    <span class="initial"><%= user.nom[0] %></span> <!-- Initiale du nom -->
                </div>
                <div class="profile-info">
                    <h1>Nom: <%= user.nom %> <%= user.prenom %></h1> <!-- Nom et prénom de l'utilisateur -->
                </div>
            </div>
            <div class="info-container">
                <h2>Dossier</h2>
                <div class="info-row">
                    <div class="info-column">
                        <div class="info-box">
                            <p><strong>ID:</strong> <%= user.id %></p> <!-- ID de l'utilisateur -->
                        </div>
                        <div class="info-box">
                            <p><strong>Date d'inscription:</strong> <%= user.date_inscription.toLocaleDateString() %></p> <!-- Date d'inscription -->
                        </div>
                        <div class="info-box">
                            <p><strong>Téléphone:</strong> <%= user.telephone %></p> <!-- Numéro de téléphone -->
                        </div>
                        <div class="info-box">
                            <p><strong>Email:</strong> <%= user.email %></p> <!-- Email -->
                        </div>
                        <div class="info-box">
                            <p><strong>Statut:</strong> <%= user.statut || "Actif" %></p> <!-- statut de l'utilisateur -->
                        </div>
                    </div>
                    <div class="info-column">
                        <div class="info-box">
                            <p><strong>Date de naissance:</strong> <%= user.date_naissance.toLocaleDateString() %></p> <!-- Date de naissance -->
                        </div>
                        <div class="info-box">
                            <p><strong>Langue:</strong> <%= user.langue %></p> <!-- Langue -->
                        </div>
                        <div class="info-box">
                            <p><strong>Adresse:</strong> <%= user.adresse %></p> <!-- Adresse -->
                        </div>
                        <div class="info-box">
                            <p><strong>Mot de passe:</strong> ********</p>
                        </div>
                    </div>
                </div>
                <form action="/modifier" method="POST">
                    <button type="submit" class="modifier">Modifier</button>
                </form>
                <br>
                <form action="/deconnexion" method="POST">
                    <button type="submit" class="deconnecter">Se déconnecter</button>
                </form>
            </div>
        </div>
        <%- include ("../partials/footer.ejs") %>
</body>

</html>
