<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <link rel="stylesheet" href="../CSS/profile.css">
    <script>
        function enableEdit() {
            document.querySelectorAll('.editable').forEach(function (element) {
                element.disabled = false; // Enable all editable fields
            });
            document.getElementById('saveButton').style.display = 'inline-block'; // Show the Save button
            document.getElementById('saveForm').style.display = 'block'; // Show the form for saving
            document.querySelector('.modifier').style.display = 'none'; // Hide the "Modify" button
        }
    </script>
</head>

<body style="background-color:rgb(22, 23, 21);">
    <%- include ("../partials/header.ejs") %>
        <div class="forme">
            <div class="profile-container">
                <div class="profile-cercle">
                    <span class="initial">
                        <%= user.nom[0] %>
                    </span> <!-- Initiale du nom -->
                </div>
                <div class="profile-info">
                    <h1>
                        <%= user.nom %>
                            <%= user.prenom %>
                    </h1> <!-- Nom et prénom de l'utilisateur -->
                </div>
            </div>
            <div class="info-container" style="background-color: rgb(240, 240, 240);">
                <h2>Dossier</h2>
                <form action="/modifier" method="POST" id="saveForm">
                    <div class="info-row">
                        <div class="info-column">
                            <div class="info-box">
                                <p><strong>ID:</strong>
                                    <input type="text" name="id" value="<%= user.id || '' %>" disabled>
                                </p> <!-- ID de l'utilisateur -->
                            </div>
                            <div class="info-box">
                                <p><strong>Date d'inscription:</strong>
                                    <input type="text" name="date_inscription"
                                        value="<%= user.date_inscription ? user.date_inscription.toLocaleDateString() : '' %>"
                                        disabled>
                                </p> <!-- Date d'inscription -->
                            </div>
                            <div class="info-box">
                                <p><strong>Téléphone:</strong>
                                    <input type="text" name="telephone" value="<%= user.telephone || '' %>"
                                        class="editable" disabled>
                                </p> <!-- Numéro de téléphone -->
                            </div>
                            <div class="info-box">
                                <p><strong>Email:</strong>
                                    <input type="email" name="email" value="<%= user.email || '' %>" class="editable"
                                        disabled>
                                </p> <!-- Email -->
                            </div>
                            <div class="info-box">
                                <p><strong>Statut:</strong>
                                    <input type="text" name="statut" value="<%= user.statut || 'Actif' %>" disabled>
                                </p> <!-- statut de l'utilisateur -->
                            </div>
                        </div>
                        <div class="info-column">
                            <div class="info-box">
                                <p><strong>Date de naissance:</strong>
                                    <input type="date" name="date_naissance"
                                        value="<%= user.date_naissance ? new Date(user.date_naissance).toISOString().split('T')[0] : '' %>"
                                        class="editable" disabled>
                                </p> <!-- Date de naissance -->
                            </div>
                            <div class="info-box">
                                <p><strong>Langue:</strong>
                                    <input type="text" name="langue" value="<%= user.langue || '' %>" class="editable"
                                        disabled>
                                </p> <!-- Langue -->
                            </div>
                            <div class="info-box">
                                <p><strong>Adresse:</strong>
                                    <input type="text" name="adresse" value="<%= user.adresse || '' %>" class="editable"
                                        disabled>
                                </p> <!-- Adresse -->
                            </div>
                            <div class="info-box">
                                <p><strong>Mot de passe:</strong>
                                    <input type="text" name="mot_de_passe" value="*********" disabled>
                                </p>
                                <p style="font-size: small;"><a href="Mot_de_passe_oublie.html">Changer mot de passe</a>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Hidden fields for ID, nom, prenom, mot_de_passe, statut -->
                    <input type="hidden" name="id" value="<%= user.id %>">
                    <input type="hidden" name="nom" value="<%= user.nom %>">
                    <input type="hidden" name="prenom" value="<%= user.prenom %>">
                    <input type="hidden" name="mot_de_passe" value="<%= user.mot_de_passe %>">
                    <input type="hidden" name="statut" value="<%= user.statut %>">

                    <!-- Buttons -->
                    <button type="button" class="modifier" onclick="enableEdit()">Modifier</button> <!-- Modifier -->
                    <button type="submit" class="modifier" id="saveButton" style="display:none;">Sauvegarder</button>
                    <!-- Sauvegarder -->
                </form>

                <form action="/deconnexion" method="GET">
                    <br>
                    <button type="submit" class="deconnecter">Se déconnecter</button>
                </form>
            </div>
        </div>
        <%- include ("../partials/footer.ejs") %>
</body>

</html>