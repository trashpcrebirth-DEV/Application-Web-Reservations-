<!-- details-reservation.ejs -->
<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Détails de la réservation | SportZone</title>
    <link rel="stylesheet" href="/CSS/information_reservation.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
    <%- include ("../partials/header.ejs") %>
        <div class="conteneur">
            <a href="/reservation" class="lien-retour">
                <i class="fas fa-arrow-left"></i> Retour aux réservations
            </a>

            <div class="carte-details">
                <div class="entete">
                    <h1>Réservation #<%= reservation.id_reservation %>
                    </h1>
                    <span class="statut <%= reservation.statut === 'Disponible' ? 'pasreserve' : 'reserve' %>">
                        <%= reservation.statut %>
                    </span>
                </div>

                <div class="contenu">
                    <div class="grille">
                        <div class="section">
                            <h2>Détails de la réservation</h2>

                            <div class="element-info">
                                <i class="fas fa-calendar icone"></i>
                                <div>
                                    <p class="etiquette"><u>Date</u></p>
                                    <p class="valeur">
                                        <%= new Date(reservation.date_time).toLocaleDateString() %>
                                    </p>
                                </div>
                            </div>

                            <div class="element-info">
                                <i class="fas fa-clock icone"></i>
                                <div>
                                    <p class="etiquette"><u>Heure</u></p>
                                    <p class="valeur">
                                        <%= new Date(reservation.date_time).toLocaleTimeString("fr-FR", {
                                            hour: "2-digit" , minute: "2-digit" }) %>
                                    </p>
                                </div>
                            </div>

                            <div class="element-info">
                                <i class="fas fa-basketball-ball icone"></i>
                                <div>
                                    <p class="etiquette"><u>Sport</u></p>
                                    <p class="valeur">
                                        <%= reservation.categorie_sport %>
                                    </p>
                                </div>
                            </div>

                            <div class="element-info">
                                <i class="fas fa-map-marker-alt icone"></i>
                                <div>
                                    <p class="etiquette"><u>Terrain</u></p>
                                    <p class="valeur">
                                        <%= nom_installation %>
                                    </p>
                                </div>
                            </div>

                            <div class="element-info">
                                <i class="fa-solid fa-dollar-sign icone"></i>
                                <div>
                                    <p class="etiquette"><u>Prix total</u> - <%= reservation.prix %>$ par personne 
                                    </p>
                                    <p class="valeur prix" id="prix">
                                        <%= reservation.prix %> $
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="section">
                            <h2>Informations du client</h2>

                            <div class="bloc-info">
                                <p class="etiquette"><u>Nom</u></p>
                                <p class="valeur">
                                    <%= user.nom %>
                                </p>
                            </div>

                            <div class="bloc-info">
                                <p class="etiquette"><u>Email</u></p>
                                <p class="valeur">
                                    <%= user.email %>
                                </p>
                            </div>

                            <div class="bloc-info">
                                <p class="etiquette"><u>Téléphone</u></p>
                                <p class="valeur">
                                    <%= user.telephone %>
                                </p>
                            </div>

                            <div class="info-paiement">
                                <h3>Nombre de participants</h3>
                                <input type="number" name="nombreJoueurs" value="1" id="nombreJoueurs" min="1" required>
                            </div>
                        </div>
                    </div>

                    <div class="actions">
                        <p id="id-reservation" data-id="<%= reservation.id_reservation %>"></p>
                        <form action="/reserver/<%= reservation.id_reservation %>/<%= nombreJoueurs %>" method="POST">
                            <% if (isDansPanier) { %>
                                <button type="submit" class="bouton primaire-reserver" disabled>Réservé</button>
                                <% } else { %>
                                    <button type="submit" class="bouton primaire">Réserver</button>
                                    <% } %>
                        </form>
                        <% if (isDejaReserve) { %>
                            <form class="bouton annuler" action="/api/annuler/<%= reservation.id_reservation %>" method="POST">
                                <button type="submit" class="bouton danger">Annuler</button>
                            </form>
                        <% } %>
                    </div>

                   
                </div>
            </div>
        </div>
        <%- include ("../partials/footer.ejs") %>

        <script src="/Javascript/information_reservation.js"></script>
</body>

</html>