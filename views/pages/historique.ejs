<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('../partials/head') %>
    <title><%= siteTitle %> - <%= pageTitle %></title>
    <link rel="stylesheet" href="/css/historique.css">
</head>

<body>
    <%- include ("../partials/header.ejs") %>

    <main class="container mt-5">
        <div class="text-center">
            <h1 class="page-title"><i class="fas fa-history"></i> <%= pageTitle %></h1>
            <p class="lead text-muted">Consultez vos paiements récents ci-dessous</p>
        </div>

        <% if (paiements.length === 0) { %>
            <div class="alert alert-info text-center">
                <i class="fas fa-exclamation-circle"></i> Aucun paiement dans votre historique
            </div>
        <% } else { %>
            <div class="paiement-list">
                <% paiements.forEach(p => { %>
                <div class="paiement-item">
                    <div class="paiement-header">
                        <div class="paiement-title">
                            <h5>Paiement #<%= p._id.toString().substr(18, 6) %></h5>
                            <small class="text-muted">
                                <i class="fas fa-calendar-alt"></i> <%= new Date(p.date).toLocaleDateString('fr-FR') %>
                            </small>
                        </div>
                        <div class="paiement-status">
                            <span class="badge <%= p.status === 'succeeded' ? 'badge-success' : 'badge-warning' %>">
                                <%= p.status === 'succeeded' ? 'Réussi' : 'En attente' %>
                            </span>
                            <div class="amount">
                                <i class="fas fa-euro-sign"></i> <%= (p.amount / 100).toFixed(2) %> €
                            </div>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        <% } %>

    </main>

    <%- include ("../partials/footer.ejs") %>

</body>

</html>
