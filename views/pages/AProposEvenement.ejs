<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nos évenements</title>
    <link rel="stylesheet" href="/CSS/AProposEvenement.css">
</head>
<body>
    <%- include ("../partials/header.ejs") %>
    <section class="banniere">
        <div class="conteneur">
            <h2>Nos Événements de 2025</h1>
            <p>Découvrez les événements sportifs que nous organisons tout au long de l'année</p>
        </div>
    </section>

    <main class="lineTemps-container">
        <% evenementsParMois.forEach((mois) => { %>
            <div class="mois-section">
                <div class="mois-marker">
                    <span><%= mois.month %></span>
                </div>
    
                <div class="evenements-list">
                    <% if (mois.items.length > 0) { %>
                        <% mois.items.forEach((evenement) => { %>
                            <div class="evenement-card">
                                <div class="evenement-content">
                                    <div class="evenement-image">
                                        <img src="<%= evenement.image %>" alt="<%= evenement.titre %>">
                                    </div>
                                    <h3><%= evenement.titre %></h3>
                                    <div class="evenement-details">
                                        <div class="detail">
                                            <i class="icon-calendar"></i>
                                            <%= evenement.date %>
                                        </div>
                                        <div class="detail">
                                            <i class="icon-location"></i>
                                            <%= evenement.lieu %>
                                        </div>
                                        <div class="detail">
                                            <i class="icon-users"></i>
                                            <%= evenement.participants %>
                                        </div>
                                    </div>
                                    <p class="evenement-description"><%= evenement.description %></p>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="pas-evenement">Aucun événement prévu ce mois-ci.</p>
                    <% } %>
                </div>
            </div>
        <% }); %>
    </main>
    
    <section class="services-complementaires">
        <div class="conteneur">
            <h3>Services complémentaires</h3>
            <div class="grille-services">
                <div class="carte-service">
                    <div class="icone-service vestiaires"><i class="fa-regular fa-circle-user"></i></div>
                    <h5>Vestiaires modernes</h5>
                    <p>Vestiaires spacieux avec casiers sécurisés et douches individuelles.</p>
                </div>
                <div class="carte-service">
                    <div class="icone-service parking"><i class="fa-solid fa-car"></i></div>
                    <h5>Parking gratuit</h5>
                    <p>Plus de 200 places de stationnement pour nos membres et visiteurs.</p>
                </div>
                <div class="carte-service">
                    <div class="icone-service cafeteria"><i class="fa-solid fa-utensils"></i></div>
                    <h5>Cafétéria sportive</h5>
                    <p>Espace de restauration proposant des repas équilibrés et boissons énergisantes.</p>
                </div>
            </div>
        </div>
    </section>
    
    <section class="contacter-section">
        <div class="conteneur">
            <h3>Prêt à organiser un évenement?</h3>
            <p>Venez nous contact pour organiser un évenement ici à SportZone et découvrez par vous-même la qualité de notre service.</p>
            <div class="boutons">
                <a href="/contact" class="bouton-contacter"><i class="fa-solid fa-calendar"></i> CONTACTER NOUS!</a> 
            </div>
        </div>
    </section>
    <%- include ("../partials/footer.ejs") %>
</body>
</html>