<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nos événements | SportZone</title>
    <link rel="stylesheet" href="/CSS/AProposEvenement.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <%- include ("../partials/header.ejs") %>
    
    <!-- Bannière -->
    <section class="hero">
        <div class="hero-overlay"></div>
        <div class="conteneur">
            <h1>Événements <span>SportZone</span></h1>
            <p>Découvrez nos événements sportifs et rejoignez la communauté</p>
        </div>
    </section>
    
    <!-- Filtres -->
    <div class="filtres">
        <div class="conteneur">
            <div class="filtres-titre">
                <h2>Calendrier des événements</h2>
                <p>Explorez notre programmation sportive</p>
            </div>
        </div>
    </div>
    
    <!-- Timeline des événements -->
    <div class="timeline">
        <div class="conteneur">
            <% evenementsParMois.forEach((mois) => { %>
                <div class="mois-bloc">
                    <div class="mois-titre">
                        <span><%= mois.month %></span>
                    </div>
                    
                    <div class="evenements-grid">
                        <% if (mois.items.length > 0) { %>
                            <% mois.items.forEach((evenement) => { %>
                                <div class="evenement-card">
                                    <div class="evenement-date">
                                        <span class="jour"><%= new Date(evenement.date).getDate() %></span>
                                        <span class="mois"><%= new Date(evenement.date).toLocaleString('fr-FR', {month: 'short'}) %></span>
                                    </div>
                                    
                                    <div class="evenement-image">
                                        <img src="<%= evenement.image || '/images/default-event.jpg' %>" alt="<%= evenement.titre %>">
                                        <div class="evenement-type"><%= evenement.type || 'Événement' %></div>
                                    </div>
                                    
                                    <div class="evenement-contenu">
                                        <h3><%= evenement.titre %></h3>
                                        
                                        <div class="evenement-infos">
                                            <div class="info">
                                                <i class="fas fa-map-marker-alt"></i>
                                                <span><%= evenement.lieu %></span>
                                            </div>
                                            <div class="info">
                                                <i class="fas fa-users"></i>
                                                <span><%= evenement.participants %> participants</span>
                                            </div>
                                        </div>
                                        
                                        <p class="evenement-description"><%= evenement.description %></p>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="pas-evenement">
                                <div class="icon-wrapper">
                                    <i class="fas fa-calendar-times"></i>
                                </div>
                                <h4>Aucun événement prévu</h4>
                                <p>Revenez bientôt pour découvrir nos prochains événements</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }); %>
        </div>
    </div> 
    
    <section class="services">
        <div class="conteneur">
            <div class="section-titre">
                <h2>Nos services</h2>
                <p>Pour une expérience sportive complète</p>
            </div>
            
            <div class="services-grid">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-tshirt"></i>
                    </div>
                    <h3>Vestiaires modernes</h3>
                    <p>Vestiaires spacieux avec casiers sécurisés et douches individuelles.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-car"></i>
                    </div>
                    <h3>Parking gratuit</h3>
                    <p>Plus de 200 places de stationnement pour nos membres et visiteurs.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-utensils"></i>
                    </div>
                    <h3>Cafétéria sportive</h3>
                    <p>Espace de restauration proposant des repas équilibrés et boissons énergisantes.</p>
                </div>
            </div>
        </div>
    </section>
    
    <section class="cta">
        <div class="conteneur">
            <h2>Prêt à rejoindre un événement?</h2>
            <p>Contactez-nous pour plus d'informations ou pour organiser votre propre événement sportif</p>
            <a href="/contact" class="cta-btn"><i class="fa-solid fa-calendar"></i> Contactez-nous</a>
        </div>
    </section>
    
    <%- include ("../partials/footer.ejs") %>

    <script>
        document.addEventListener('DOMContentLoaded', function() {       
            const eventCards = document.querySelectorAll('.evenement-card');
            
            const cardObserver = new IntersectionObserver(function(entries) {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        cardObserver.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1 });
            
            eventCards.forEach(card => {
                cardObserver.observe(card);
            });
        });
    </script>
</body>
</html>