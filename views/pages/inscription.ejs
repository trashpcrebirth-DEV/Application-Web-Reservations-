<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscription</title>
    <link rel="stylesheet" href="/CSS/Inscription.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body style="font-family:Arial, Helvetica, sans-serif;">

    <div class="container">
        <div class="form-logo-container">
            <a href="/">
                <img class="logo-link" src="Images/0a66564e-598c-4af2-a6ba-d4a4283ed573d.png" alt="Sportzone_Logo">
            </a>
            <div class="form-container">
                <h2 class="centrer" style="margin-top: 10%; margin-bottom: 10%;">INSCRIPTION</h2>

                <form id="inscriptionForm" action="/inscription" method="POST">
                    <label for="nom">Nom</label>
                    <br>
                    <input type="text" id="nom" name="nom" required>
                    <br>
                    <label for="prenom">Prénom</label>
                    <br>
                    <input type="text" id="prenom" name="prenom" required>
                    <br>
                    <label for="email">Adresse courriel</label>
                    <br>
                    <input type="email" id="email" name="email" required>
                    <div id="emailError" class="error-message">Adresse courriel existe déjà</div>
                    <br>
                    <label for="password">Mot de passe</label>
                    
                    <div id="passwordStrengthMessage" class="strength-message"></div>
                    <div id="passwordStrength">
                        <div id="passwordStrengthBar"></div>
                    </div>

                    <div class="password-container">
                        <input type="password" id="mot_de_passe" name="mot_de_passe" required>
                        <i class="fa fa-eye" id="togglePassword"></i>
                    </div>
                    
                    <div id="passwordWeakError" class="error-message">Mot de passe trop faible</div>

                    
                    <br>

                    <label for="confirm_password">Confirmation de mot de passe</label>
                    <br>
                    <div class="password-container">
                        <input type="password" id="confirm_password" name="confirm_password" required>
                        <i class="fa fa-eye" id="toggleConfirmPassword"></i>
                    </div>
                    <br>
                    
                    <div id="passwordError" class="error-message">Les mots de passe ne correspondent pas.</div>
                    <br>
                    <input type="submit" value="S'INSCRIRE">
                </form>

                <div class="link">
                    <p class="centrer"><a href="Mot_de_passe_oublie.html">Mot de passe oublié ?</a></p>
                    <p class="centrer">Déjà un compte ? <a href="/connexion">Connexion</a></p>
                </div>
            </div>
        </div>

       
    </div>

    <script src="/Javascript/Inscription.js"></script>

</body>

</html>