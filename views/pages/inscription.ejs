<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/CSS/Inscription.css">
</head>

<body style="font-family:Arial, Helvetica, sans-serif;">

    <div class="container">
        <div class="form-container">
            <a href="/" class="logo-link">
                <img style="margin-left: 25%;" src="Images/0a66564e-598c-4af2-a6ba-d4a4283ed573d.png"
                    alt="Sportzone_Logo">
            </a>
            <h2 class="centrer">INSCRIPTION</h2>

            <form>
                <label for="nom">Nom</label>
                <br>
                <input type="text" id="nom" name="nom" required>
                <br>
                <label for="prenom">Prénom</label>
                <br>
                <input type="text" id="prenom" name="prenom" required>
                <br>
                <label for="email">Adresse courriel</label>
                <br>
                <input type="email" id="email" name="email" required>
                <br>
                <label for="password">Mot de passe</label>
                <br>
                <input type="password" id="password" name="password" required>
                <br>
                <input type="submit" value="S'INSCRIRE">
            </form>

            <div class="link">
                <p class="centrer"><a href="Mot_de_passe_oublie.html">Mot de passe oublié ?</a></p>
                <p class="centrer">Déjà un compte ? <a href="/connexion">Connexion</a></p>
            </div>
        </div>

        <img src="Images/bf29a9d2-cfc5-42f0-a6e9-9e1fe83b91a7.jpg" alt="Centre_Sportif">

    </div>

</body>

</html>