<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/CSS/header.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- https://stackoverflow.com/questions/71201741/how-to-use-font-awesome-6-icons -->
</head>

<body style="background-color: #181818;">
    <!--HEADER-->
    <header>
        <div class="bar-de-navigation">
            <a href="/" class="logo-link">
                <h1 class="sportZone">
                    <img class="logo" src="/images/logoSportZone.png" alt="Erreur de chargement">
                </h1>
            </a>
            <ul>
                <li class="<%= activePage === 'accueil' ? 'bar-page-actuel' : '' %>"><a
                        href="/"><span>Accueil</span></a></li>
                <li class="<%= activePage === 'reservation' ? 'bar-page-actuel' : '' %>"><a
                        href="/reservation">Réservation</a></li>
                <li class="<%= activePage === 'contact' ? 'bar-page-actuel' : '' %>"><a href="/contact">Contact</a></li>
                <% if (!user) { %>
                    <li class="boite-bleu"><a href="/connexion"><i class="fa-solid fa-user"></i> Se connecter</a> </li>
                    <% } else { %>
                        <li class="boite-bleu"><a href="/profile"><i class="fa-solid fa-user"></i><span>
                                    Profile</span></a></li>
                                    <li class="notification-icon">
                                        <a href="#" onclick="toggleNotifications()" class="notification-link">
                                            <i class="fa-solid fa-bell"></i>
                                            <span id="notification-count" class="notification-badge" style="display: none;">0</span>
                                        </a>
                                        <div id="notifications" class="notification-dropdown"></div>
                                    </li>
                                    
                                    <li class="cart-icon">
                                        <li class="cart-icon">
                                            <a href="/paiement" class="cart-link">
                                                <i class="fa-solid fa-cart-shopping"></i>
                                                <% if (user.cartCount > 0) { %>
                                                    <span id="cart-count" class="cart-badge"><%= user.cartCount %></span>
                                                <% } %>
                                            </a>
                                        </li>
                        <% } %>
            </ul>
        </div>
    </header>
    <!--FIN DU HEADER-->
</body>
<script>
    let previousNotificationCount = 0;

    async function loadNotifications() {
    try {
        const response = await fetch("/api/notifications");
        const data = await response.json();

        if (data.success) {
            const notificationsContainer = document.getElementById("notifications");
            const notificationCount = document.getElementById("notification-count");
            const bellIcon = document.querySelector(".notification-link i");

            notificationsContainer.innerHTML = "";

            const currentCount = data.notifications.length;

            // Comparer avec la valeur précédente
            if (currentCount > previousNotificationCount) {
                bellIcon.classList.add("ring-animation");

                // Supprimer l'animation après la fin pour pouvoir la rejouer
                setTimeout(() => {
                    bellIcon.classList.remove("ring-animation");
                }, 600);
            }

            previousNotificationCount = currentCount;

            if (currentCount > 0) {
                notificationCount.style.display = "inline-block";
                notificationCount.textContent = currentCount;
            } else {
                notificationCount.style.display = "none";
            }

            // Vérification si les notifications sont vides
            if (currentCount === 0) {
                const noNotificationMessage = document.createElement("div");
                noNotificationMessage.className = "no-notification-message";
                noNotificationMessage.innerHTML = "<p>Pas de notifications</p>";
                notificationsContainer.appendChild(noNotificationMessage);
            } else {
                // Si des notifications existent, les afficher
                data.notifications.forEach(notif => {
                    const notifItem = document.createElement("div");
                    notifItem.className = "notification-item";
                    notifItem.innerHTML = `
                        <p>${notif.message}</p>
                        <button class="btn-marquer-lu" onclick="markAsRead(${notif.id})">Marquer comme lu</button>
                    `;
                    notificationsContainer.appendChild(notifItem);
                });
            }
        }
    } catch (error) {
        console.error("Erreur lors du chargement des notifications :", error);
    }
}


    async function markAsRead(id) {
        await fetch(`/api/notifications/${id}/lire`, { method: "POST" });
        loadNotifications(); // Recharge les notifications après marquage
    }

    function toggleNotifications() {
        const container = document.getElementById("notifications");
        container.style.display = (container.style.display === "block") ? "none" : "block";
    }

    document.addEventListener("DOMContentLoaded", loadNotifications);
</script>


<div id="notifications"></div>
